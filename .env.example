# Hosted values are configured through Sites and must never be committed with values.
EVIDENCE_ENCRYPTION_KEY=
EVIDENCE_ACTIVE_KEY_ID=legacy-v1
# JSON object mapping retained key IDs to base64-encoded 32-byte AES keys.
EVIDENCE_KEYRING_JSON=
AUDIT_HMAC_KEY=
AUDIT_ACTIVE_KEY_ID=legacy-v1
# Canonical base64 encoding of at least 32 random bytes. Keyring values use
# the same format; generate each with `openssl rand -base64 32`.
# JSON object mapping retained audit key IDs to base64 HMAC keys.
AUDIT_KEYRING_JSON=
AUDIT_CHECKPOINT_ENDPOINT=https://your-independent-log.example/v1/scopeproof-checkpoints
AUDIT_CHECKPOINT_ALLOWED_HOSTS=your-independent-log.example
AUDIT_CHECKPOINT_TOKEN=
# Base64 SPKI P-256 key used to verify receipts signed by the independently
# administered append-only checkpoint service.
AUDIT_CHECKPOINT_RECEIPT_PUBLIC_KEY=
SECURITY_EVENT_ENDPOINT=https://your-monitoring.example/v1/scopeproof-health
SECURITY_EVENT_ALLOWED_HOSTS=your-monitoring.example
# Required independent bearer credential; 16–4096 trimmed, control-free characters.
SECURITY_EVENT_TOKEN=
PACKAGE_SIGNING_PRIVATE_KEY=
PACKAGE_SIGNING_PUBLIC_KEY=
BOOTSTRAP_ADMIN_EMAILS=
TRUSTED_APP_ORIGINS=https://your-scopeproof-host.example
# Required exact acknowledgement. This runtime supports one tenant and one
# canonical origin only. Never reuse its D1/R2/key boundary for another tenant.
LEGACY_SINGLE_TENANT_ACKNOWLEDGEMENT=single-tenant-only

# AWS collector. Only temporary STS credentials are accepted; rotate all three
# values together before the session expires. Long-lived IAM-user keys fail closed.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1

# GitHub collector and optional managed hosted repository SBOM access. Browser
# and native Mac one-time SBOM access do not use these values. Use the exact organization login. Prefer a
# GitHub App installation token or fine-grained token limited to intended
# repositories with Metadata:read and Contents:read only; an external process
# must rotate expiring installation tokens.
GITHUB_TOKEN=
GITHUB_ORG=

# Okta collector
OKTA_BASE_URL=
OKTA_API_TOKEN=

# Cloudflare collector and independent screenshot safety scanning. The OCR
# service receives exact PNG pixels from both Browser Rendering and hosted Mac
# uploads, returns only {sha256,text,policyVersion}, and must be independently
# operated, privacy-approved, HTTPS-only, and present on the exact host allowlist.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_IDS=
BROWSER_CAPTURE_URLS=
BROWSER_OCR_ENDPOINT=https://your-approved-ocr-service.example/v1/scan
BROWSER_OCR_TOKEN=
BROWSER_OCR_ALLOWED_HOSTS=your-approved-ocr-service.example
MACOS_RELEASE_MANIFEST_JSON=
MACOS_RELEASE_SIGNATURE_DER_BASE64=
MACOS_RELEASE_ALLOWED_HOSTS=downloads.your-company.example
RFC3161_TSA_URL=
RFC3161_VERIFIER_URL=https://your-rfc3161-verifier.example/v1/verify
RFC3161_VERIFIER_PUBLIC_KEYS=
RFC3161_VERIFIER_TOKEN=
RFC3161_VERIFIER_ALLOWED_HOSTS=your-rfc3161-verifier.example
RFC3161_TSA_TRUST_ANCHOR_SHA256=
# Secure default is true when omitted. A false value is permitted only for
# local development diagnostics and always makes production readiness fail.
REQUIRE_TRUSTED_TIMESTAMP=true

# Jira Cloud OAuth 2.0 (3LO). The callback must exactly match the URL configured
# in the Atlassian developer console. Keep the client secret and token key only
# in the hosted secret manager.
JIRA_OAUTH_CLIENT_ID=
JIRA_OAUTH_CLIENT_SECRET=
JIRA_OAUTH_CALLBACK_URL=https://your-scopeproof-host.example/api/jira/oauth/callback
JIRA_OAUTH_TOKEN_ENCRYPTION_KEY=
JIRA_OAUTH_ACTIVE_KEY_ID=legacy-v1
JIRA_OAUTH_KEYRING_JSON=
