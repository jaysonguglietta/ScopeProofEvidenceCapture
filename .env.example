# Hosted values are configured through Sites and must never be committed with values.
EVIDENCE_ENCRYPTION_KEY=
EVIDENCE_ACTIVE_KEY_ID=legacy-v1
# JSON object mapping retained key IDs to base64-encoded 32-byte AES keys.
EVIDENCE_KEYRING_JSON=
AUDIT_HMAC_KEY=
AUDIT_ACTIVE_KEY_ID=legacy-v1
# JSON object mapping retained audit key IDs to high-entropy HMAC secrets.
AUDIT_KEYRING_JSON=
AUDIT_CHECKPOINT_ENDPOINT=https://your-independent-log.example/v1/scopeproof-checkpoints
AUDIT_CHECKPOINT_ALLOWED_HOSTS=your-independent-log.example
AUDIT_CHECKPOINT_TOKEN=
PACKAGE_SIGNING_PRIVATE_KEY=
PACKAGE_SIGNING_PUBLIC_KEY=
BOOTSTRAP_ADMIN_EMAILS=
TRUSTED_APP_ORIGINS=https://your-scopeproof-host.example

# AWS collector
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1

# GitHub collector
GITHUB_TOKEN=
GITHUB_ORG=

# Okta collector
OKTA_BASE_URL=
OKTA_API_TOKEN=

# Cloudflare collector and browser capture
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_IDS=
BROWSER_CAPTURE_URLS=
BROWSER_OCR_ENDPOINT=https://your-approved-ocr-service.example/v1/scan
BROWSER_OCR_TOKEN=
BROWSER_OCR_ALLOWED_HOSTS=your-approved-ocr-service.example
MACOS_RELEASE_MANIFEST_JSON=
MACOS_RELEASE_SIGNATURE_DER_BASE64=
MACOS_RELEASE_ALLOWED_HOSTS=downloads.your-company.example
RFC3161_TSA_URL=
RFC3161_VERIFIER_URL=https://your-rfc3161-verifier.example/v1/verify
RFC3161_VERIFIER_PUBLIC_KEYS=
RFC3161_VERIFIER_TOKEN=
RFC3161_VERIFIER_ALLOWED_HOSTS=your-rfc3161-verifier.example
RFC3161_TSA_TRUST_ANCHOR_SHA256=

# Jira Cloud OAuth 2.0 (3LO). The callback must exactly match the URL configured
# in the Atlassian developer console. Keep the client secret and token key only
# in the hosted secret manager.
JIRA_OAUTH_CLIENT_ID=
JIRA_OAUTH_CLIENT_SECRET=
JIRA_OAUTH_CALLBACK_URL=https://your-scopeproof-host.example/api/jira/oauth/callback
JIRA_OAUTH_TOKEN_ENCRYPTION_KEY=
JIRA_OAUTH_ACTIVE_KEY_ID=legacy-v1
JIRA_OAUTH_KEYRING_JSON=
